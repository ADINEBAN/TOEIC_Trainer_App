# =============================================================================
# TOEIC Trainer backend — environment variables
# Copy to .env (or export in your shell / hosting provider) and fill in.
# NEVER commit real secrets to git.
# =============================================================================

# --- Database (Supabase Postgres recommended) ---
# Get the connection string in Supabase: Project Settings -> Database ->
# Connection string -> URI (use "Session" pooler mode for direct JDBC).
DB_URL=jdbc:postgresql://localhost:5432/toeic_trainer
DB_USER=postgres
DB_PASSWORD=postgres

# --- JWT auth ---
# Random 32+ byte string. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-byte-secret
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# --- Speechify (voice: george / simba-3.2) ---
# Server-side key ONLY. If empty, /api/tts returns 503 {fallback:true}
# and the app uses the device voice.
SPEECHIFY_API_KEY=

# --- AI provider (Gemini via Google Generative AI) ---
# Server-side key ONLY. If empty, AI endpoints return 503 with an honest message.
AI_API_KEY=
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.1-flash-lite
AI_VISION_MODEL=gemini-3.1-flash-lite
# Per-user daily AI budget (input+output chars, across all features)
AI_DAILY_CHAR_LIMIT=200000

# --- CORS ---
# Comma-separated origins, or * for dev. Expo Go needs the dev machine's LAN URL.
CORS_ALLOWED_ORIGINS=*

# --- Uploaded files (photos, documents) ---
# Local dir for now. Supabase Storage integration point: swap saveFile() in
# AiService for a Storage upload and store the public path instead.
STORAGE_DIR=./uploads

# --- Server ---
PORT=8080
